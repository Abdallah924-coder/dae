{
  "name": "dae",
  "version": "1.0.0",
  "description": "",
  "main": "server/index.js",
  "scripts": {
    "build": "vite build",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\" vite.config.js",
    "lint": "eslint client/src server",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "start": "node server/index.js",
    "start:local": "node -r ./server/tools/loadLocalEnv.js server/index.js",
    "dev": "node --watch server/index.js",
    "dev:local": "node -r ./server/tools/loadLocalEnv.js --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "seed": "node server/seed.js",
    "expire": "node server/jobs/expireOrders.js",
    "bsc:deposits": "node server/jobs/indexBscDeposits.js",
    "bsc:deposits:local": "node -r ./server/tools/loadLocalEnv.js server/jobs/indexBscDeposits.js",
    "bsc:signer": "node server/jobs/runBscSigner.js",
    "bsc:derive-config": "node server/tools/printBscPublicConfig.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^18.0.5",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^14.0.0",
    "prettier": "^3.9.10",
    "vite": "^6.3.5"
  }
}
